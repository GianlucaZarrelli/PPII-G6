<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ProyectoFinal_PPII_G6.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ProyectoFinal_PPII_G6.Views"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <Tab Title="Inicio">
            <ShellContent
                Title="Menú"
                ContentTemplate="{DataTemplate views:HomePage}"
                Route="HomePage" />
        </Tab>

        <Tab Title="Alumnos">
            <ShellContent
                Title="Gestión"
                ContentTemplate="{DataTemplate views:EstudiantePage}"
                Route="GestorEstudiantes" />
        </Tab>

        <Tab Title="Historial">
            <ShellContent
                Title="Historial del alumno"
                ContentTemplate="{DataTemplate views:DetalleEstudiantePage}"
                Route="HistorialEstudiantes" />
        </Tab>

        <Tab Title="Asistencia">
            <ShellContent
                Title="Asistencia por fecha"
                ContentTemplate="{DataTemplate views:AsistenciaFechaPage}"
                Route="AsistenciaFecha" />
        </Tab>

        <Tab Title="Carga Masiva de Estudiantes">
            <ShellContent
                Title="Importar CSV"
                ContentTemplate="{DataTemplate views:CargaMasivaPage}"
                Route="CargaMasiva" />
        </Tab>
    </TabBar>

</Shell>