<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ProyectoFinal_PPII_G6.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ProyectoFinal_PPII_G6.Views"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <!-- Tab 1: Dashboard principal -->
        <Tab Title="Inicio">
            <ShellContent
                Title="Menú"
                ContentTemplate="{DataTemplate views:HomePage}"
                Route="HomePage" />
        </Tab>

        <!-- Tab 2: Gestión de estudiantes (alta y listado) -->
        <Tab Title="Alumnos">
            <ShellContent
                Title="Gestión"
                ContentTemplate="{DataTemplate views:EstudiantePage}"
                Route="GestorEstudiantes" />
        </Tab>

        <!-- Tab 3: Asistencia y riesgo -->
        <Tab Title="Asistencia">
            <ShellContent
                Title="Historial"
                ContentTemplate="{DataTemplate views:DetalleEstudiantePage}"
                Route="HistorialEstudiantes" />
        </Tab>

        <!-- Tab 4: Carga masiva CSV -->
        <Tab Title="Carga Masiva">
            <ShellContent
                Title="Importar CSV"
                ContentTemplate="{DataTemplate views:CargaMasivaPage}"
                Route="CargaMasiva" />
        </Tab>
    </TabBar>

</Shell>    