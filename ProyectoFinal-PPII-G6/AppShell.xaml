<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ProyectoFinal_PPII_G6.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ProyectoFinal_PPII_G6.Views"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <Tab Title="Inicio">
            <ShellContent Title="Menú" ContentTemplate="{DataTemplate local:HomePage}" Route="HomePage" />
        </Tab>
        <Tab Title="Alumnos">
            <ShellContent Title="Gestión" ContentTemplate="{DataTemplate local:EstudiantePage}" Route="GestorEstudiantes" />
        </Tab>
        <Tab Title="Asistencia">
            <ShellContent Title="Historial" ContentTemplate="{DataTemplate local:DetalleEstudiantePage}" Route="HistorialEstudiantes" />
        </Tab>
    </TabBar>

</Shell>