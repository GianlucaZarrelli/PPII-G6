<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoFinal_PPII_G6.Views.HomePage"
             Title="Menú Principal">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="25">

            <!-- Switch Modo Oscuro / Claro -->
            <HorizontalStackLayout HorizontalOptions="End" Spacing="10">
                <Label Text="Modo Oscuro" VerticalOptions="Center" FontAttributes="Bold" FontSize="12" />
                <Switch x:Name="ThemeSwitch" Toggled="OnThemeSwitchToggled" />
            </HorizontalStackLayout>

            <!-- Encabezado del Sistema -->
            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                <Label Text="Sistema de Alerta Temprana" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#512BD4, Dark=#A88BFF}" />
                <Label Text="Seleccione un módulo para continuar" 
                       FontSize="14" 
                       HorizontalTextAlignment="Center"
                       TextColor="Gray" />
            </VerticalStackLayout>

            <!-- Resumen de Métricas Generales -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                <Border Grid.Column="0" 
                        StrokeShape="RoundRectangle 10" 
                        BackgroundColor="{AppThemeBinding Light=#E8EAF6, Dark=#1E2138}" 
                        Padding="15" 
                        StrokeThickness="0">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Total Alumnos" FontSize="12" TextColor="#3F51B5" FontAttributes="Bold" />
                        <Label Text="{Binding TotalEstudiantes}" FontSize="28" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A237E, Dark=#82B1FF}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" 
                        StrokeShape="RoundRectangle 10" 
                        BackgroundColor="{AppThemeBinding Light=#FFEBEE, Dark=#381E1E}" 
                        Padding="15" 
                        StrokeThickness="0">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="En Riesgo Alto" FontSize="12" TextColor="#D32F2F" FontAttributes="Bold" />
                        <Label Text="{Binding EstudiantesEnRiesgo}" FontSize="28" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#B71C1C, Dark=#FF8A80}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Botones/Tarjetas de Selección de Módulo -->
            <Label Text="Módulos del Sistema" FontSize="18" FontAttributes="Bold" />

            <!-- Módulo 1: Gestión de Alumnos -->
            <Border StrokeShape="RoundRectangle 12" 
                    Padding="15" 
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}"
                    Stroke="#E0E0E0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNavegarEstudiantesClicked" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="" FontSize="32" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Gestión de Alumnos (H2)" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}" />
                        <Label Text="Registrar nuevos estudiantes y administrar la nómina." FontSize="12" TextColor="Gray" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Módulo 2: Historial e Indicador de Riesgo -->
            <Border StrokeShape="RoundRectangle 12" 
                    Padding="15" 
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}"
                    Stroke="#E0E0E0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNavegarHistorialClicked" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="" FontSize="32" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Asistencia y Alerta Temprana (H4/H6)" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}" />
                        <Label Text="Tomar asistencia y consultar el nivel de riesgo por inasistencias." FontSize="12" TextColor="Gray" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>