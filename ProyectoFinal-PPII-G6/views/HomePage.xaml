<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoFinal_PPII_G6.Views.HomePage"
             Title="Inicio">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20">

            <!-- Switch Modo Oscuro / Claro -->
            <HorizontalStackLayout HorizontalOptions="End" Spacing="10">
                <Label Text="Modo Oscuro" VerticalOptions="Center" FontAttributes="Bold" FontSize="12" />
                <Switch x:Name="ThemeSwitch" Toggled="OnThemeSwitchToggled" />
            </HorizontalStackLayout>

            <!-- Banner de Bienvenida -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Sistema de Alerta Temprana" FontSize="22" FontAttributes="Bold" TextColor="#512BD4" />
                <Label Text="Panel de Control Académico" FontSize="14" TextColor="Gray" />
            </VerticalStackLayout>

            <!-- Tarjetas de Métricas Resumen -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                <Border Grid.Column="0" StrokeShape="RoundRectangle 10" BackgroundColor="#E8EAF6" Padding="15" StrokeThickness="0">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Total Alumnos" FontSize="12" TextColor="#3F51B5" FontAttributes="Bold" />
                        <Label Text="24" FontSize="28" FontAttributes="Bold" TextColor="#1A237E" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" StrokeShape="RoundRectangle 10" BackgroundColor="#FFEBEE" Padding="15" StrokeThickness="0">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="En Riesgo Alto" FontSize="12" TextColor="#D32F2F" FontAttributes="Bold" />
                        <Label Text="3" FontSize="28" FontAttributes="Bold" TextColor="#B71C1C" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Accesos Rápidos -->
            <Label Text="Acciones Rápidas" FontSize="18" FontAttributes="Bold" Margin="0,10,0,0" />

            <Button Text="📋 Registrar / Administrar Alumnos (H2)" 
                    Clicked="OnNavegarEstudiantesClicked" 
                    BackgroundColor="#512BD4" TextColor="White" HeightRequest="50" CornerRadius="8" />

            <Button Text="📊 Ver Historial e Indicador de Riesgo (H4)" 
                    Clicked="OnNavegarHistorialClicked" 
                    BackgroundColor="#333333" TextColor="White" HeightRequest="50" CornerRadius="8" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
