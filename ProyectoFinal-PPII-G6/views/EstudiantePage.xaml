<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProyectoFinal_PPII_G6.ViewModels"
             x:Class="ProyectoFinal_PPII_G6.Views.EstudiantePage"
             Title="Gestión de Alumnos (H2)">

    <ScrollView Padding="15">
        <VerticalStackLayout Spacing="15">

            <!-- Formulario para agregar estudiante -->
            <Border StrokeShape="RoundRectangle 10" Stroke="#E0E0E0" Padding="15" BackgroundColor="White">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Alta de Estudiante" FontAttributes="Bold" FontSize="18" TextColor="#512BD4" />

                    <Entry Placeholder="DNI" Text="{Binding Dni}" Keyboard="Numeric" ClearButtonVisibility="WhileEditing" />
                    <Entry Placeholder="Nombre" Text="{Binding Nombre}" ClearButtonVisibility="WhileEditing" />
                    <Entry Placeholder="Apellido" Text="{Binding Apellido}" ClearButtonVisibility="WhileEditing" />

                    <Button Text="Guardar Estudiante" 
                            Command="{Binding GuardarEstudianteCommand}" 
                            BackgroundColor="#512BD4" 
                            TextColor="White" 
                            CornerRadius="8"
                            Margin="0,5,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Listado de Nómina -->
            <Label Text="Nómina Registrada" FontAttributes="Bold" FontSize="18" Margin="5,10,0,0" />

            <CollectionView ItemsSource="{Binding Estudiantes}" EmptyView="No hay estudiantes registrados.">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 8" Stroke="#CCCCCC" Padding="12" Margin="0,4" BackgroundColor="#F9F9F9">
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding NombreCompleto}" FontAttributes="Bold" FontSize="15" />
                                    <Label Text="{Binding Dni, StringFormat='DNI: {0}'}" FontSize="12" TextColor="Gray" />
                                </VerticalStackLayout>

                                <Button Grid.Column="1" 
                                        Text="Eliminar" 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EstudianteViewModel}}, Path=EliminarEstudianteCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#FF3B30" 
                                        TextColor="White" 
                                        HeightRequest="36"
                                        Padding="12,0" 
                                        CornerRadius="6" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
