<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoFinal_PPII_G6.Views.EstudiantePage"
             Title="Gestión de Alumnos (H2)">

    <ScrollView Padding="15">
        <VerticalStackLayout Spacing="20">

            <!-- Formulario de Alta -->
            <Border StrokeShape="RoundRectangle 10" 
                    Stroke="#E0E0E0" 
                    Padding="15" 
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Alta de Estudiante" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light=#512BD4, Dark=#A88BFF}" />

                    <!-- Campo DNI -->
                    <Entry Placeholder="DNI" 
                           Text="{Binding Dni}" 
                           Keyboard="Numeric"
                           TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}"
                           PlaceholderColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}"
                           ClearButtonVisibility="WhileEditing" />

                    <!-- Campo Nombre -->
                    <Entry Placeholder="Nombre" 
                           Text="{Binding Nombre}" 
                           TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}"
                           PlaceholderColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}"
                           ClearButtonVisibility="WhileEditing" />

                    <!-- Campo Apellido -->
                    <Entry Placeholder="Apellido" 
                           Text="{Binding Apellido}" 
                           TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}"
                           PlaceholderColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}"
                           ClearButtonVisibility="WhileEditing" />

                    <!-- Campo Email -->
                    <Entry Placeholder="Email" 
                           Text="{Binding Email}" 
                           Keyboard="Email"
                           TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}"
                           PlaceholderColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}"
                           ClearButtonVisibility="WhileEditing" />

                    <!-- Botón de Guardado -->
                    <Button Text="Guardar Estudiante" 
                            Command="{Binding GuardarEstudianteCommand}"
                            BackgroundColor="#512BD4" 
                            TextColor="White" 
                            HeightRequest="45"
                            CornerRadius="8" 
                            Margin="0,10,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Lista de Estudiantes Registrados -->
            <Label Text="Nómina Registrada" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}" />

            <CollectionView ItemsSource="{Binding Estudiantes}">
                <CollectionView.EmptyView>
                    <Label Text="No hay estudiantes registrados." 
                           HorizontalOptions="Center" 
                           TextColor="Gray" 
                           Margin="0,20" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 8" 
                                Stroke="#33FFFFFF" 
                                Padding="12" 
                                Margin="0,4"
                                BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#1E1E1E}">
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding NombreCompleto}" 
                                           FontAttributes="Bold" 
                                           FontSize="15" 
                                           TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}" />
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Text="{Binding Dni, StringFormat='DNI: {0}'}" 
                                               FontSize="12" 
                                               TextColor="Gray" />
                                        <Label Text="{Binding Email, StringFormat='| {0}'}" 
                                               FontSize="12" 
                                               TextColor="Gray" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <Button Grid.Column="1" 
                                        Text="Eliminar" 
                                        Command="{Binding BindingContext.EliminarEstudianteCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#D32F2F" 
                                        TextColor="White" 
                                        FontSize="12" 
                                        HeightRequest="36" 
                                        Padding="10,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>