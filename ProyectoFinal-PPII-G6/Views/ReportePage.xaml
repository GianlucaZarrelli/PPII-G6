<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoFinal_PPII_G6.Views.ReportePage"
             Title="Reporte de la comisión">

    <ScrollView Padding="15">
        <VerticalStackLayout Spacing="12">

            <Label Text="Comisión:" FontAttributes="Bold" FontSize="14" />
            <Picker ItemsSource="{Binding Comisiones}"
                    ItemDisplayBinding="{Binding Nombre}"
                    SelectedItem="{Binding ComisionSeleccionada}"
                    Title="-- Seleccione una comisión --"
                    TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}" />

            <Label Text="{Binding Estado}" FontSize="12" TextColor="Gray" />

            <!-- Titular: cuántos estudiantes están en riesgo de abandonar, o por qué todavía no se puede decir -->
            <Border StrokeShape="RoundRectangle 10"
                    Stroke="#E0E0E0"
                    Padding="15"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding Titular}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}" />
                    <Label Text="{Binding Detalle}"
                           FontSize="12"
                           TextColor="Gray" />
                </VerticalStackLayout>
            </Border>

            <!-- Gráfico: una barra por nivel, proporcional a la cantidad de estudiantes -->
            <VerticalStackLayout Spacing="10"
                                 IsVisible="{Binding HayGrafico}"
                                 BindableLayout.ItemsSource="{Binding Filas}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Spacing="3">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0"
                                       Text="{Binding Nivel}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{Binding Color}" />
                                <Label Grid.Column="1"
                                       Text="{Binding Resumen}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}" />
                            </Grid>
                            <BoxView HeightRequest="14"
                                     CornerRadius="4"
                                     HorizontalOptions="Start"
                                     WidthRequest="{Binding Ancho}"
                                     Color="{Binding Color}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>