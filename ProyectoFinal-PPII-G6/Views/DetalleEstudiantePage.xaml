<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoFinal_PPII_G6.Views.DetalleEstudiantePage"
             Title="Historial del alumno">

    <ScrollView Padding="15">
        <VerticalStackLayout Spacing="20">

            <!-- Selector de Alumno -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Seleccionar Estudiante:" FontAttributes="Bold" FontSize="14" />
                <Picker ItemsSource="{Binding ListaEstudiantes}"
                        ItemDisplayBinding="{Binding NombreCompleto}"
                        SelectedItem="{Binding EstudianteSeleccionado}"
                        Title="-- Seleccione un alumno --"
                        TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}" />
            </VerticalStackLayout>

            <!-- Ficha del Estudiante Seleccionado -->
            <Border StrokeShape="RoundRectangle 10"
                    Padding="15"
                    BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding EstudianteSeleccionado.NombreCompleto, FallbackValue='Sin alumno seleccionado'}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1A237E, Dark=#FFFFFF}" />

                    <Label Text="{Binding EstudianteSeleccionado.Dni, StringFormat='DNI: {0}'}"
                           FontSize="14"
                           TextColor="Gray" />

                    <Label Text="{Binding EstudianteSeleccionado.Email, StringFormat='Email: {0}'}"
                           FontSize="14"
                           TextColor="Gray" />

                    <Label Text="{Binding ComisionNombre, StringFormat='Comisión: {0}'}"
                           FontSize="14"
                           TextColor="Gray" />

                    <!-- Badge de riesgo -->
                    <Border StrokeShape="RoundRectangle 6"
                            BackgroundColor="{Binding ColorRiesgo}"
                            Padding="10,6"
                            HorizontalOptions="Start"
                            Margin="0,6,0,0">
                        <Label Text="{Binding NivelRiesgoTexto}"
                               TextColor="White"
                               FontAttributes="Bold"
                               FontSize="13" />
                    </Border>

                    <!-- Qué justifica el valor -->
                    <Label Text="{Binding DetalleAsistencia}" FontSize="13"
                           TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}" />
                    <Label Text="{Binding DetalleEntregas}" FontSize="13"
                           TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}" />
                </VerticalStackLayout>
            </Border>

            <!-- Historial de asistencia -->
            <Label Text="Historial de Asistencia" FontSize="16" FontAttributes="Bold" />

            <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding HistorialAsistencias}">
                <BindableLayout.EmptyView>
                    <Label Text="Sin clases registradas para este alumno."
                           HorizontalOptions="Center" TextColor="Gray" Margin="0,10" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 6" Padding="10"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="{Binding Fecha}" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}" />
                                <Label Grid.Column="1" Text="{Binding Estado}"
                                       FontAttributes="Bold" TextColor="{Binding Color}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Historial de entregas -->
            <Label Text="Entregas de Trabajos Prácticos" FontSize="16" FontAttributes="Bold" />

            <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding HistorialEntregas}">
                <BindableLayout.EmptyView>
                    <Label Text="No hay trabajos prácticos cargados para esta comisión."
                           HorizontalOptions="Center" TextColor="Gray" Margin="0,10" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 6" Padding="10"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}">
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Titulo}" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}" />
                                    <Label Text="{Binding FechaEntrega}" FontSize="12" TextColor="Gray" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding Estado}" VerticalOptions="Center"
                                       FontAttributes="Bold" TextColor="{Binding Color}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>