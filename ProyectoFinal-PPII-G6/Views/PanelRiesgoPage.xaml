<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoFinal_PPII_G6.Views.PanelRiesgoPage"
             Title="Alumnos por prioridad"
             BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#121212}">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="20">

            <VerticalStackLayout Spacing="4">
                <Label Text="Panel de riesgo"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#1A237E, Dark=#E8EAF6}" />
                <Label Text="¿A quién llamo esta semana?"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light=#5C6BC0, Dark=#9FA8DA}" />
            </VerticalStackLayout>

            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                    Padding="14">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Comisión"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#607D8B, Dark=#90A4AE}" />
                    <Picker ItemsSource="{Binding Comisiones}"
                            ItemDisplayBinding="{Binding Nombre}"
                            SelectedItem="{Binding ComisionSeleccionada}"
                            Title="-- Seleccione una comisión --"
                            TextColor="{AppThemeBinding Light=#212121, Dark=#FFFFFF}" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                <Border Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                        BackgroundColor="#FFEBEE" Padding="10,12">
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="{Binding CantAlto}" FontSize="22" FontAttributes="Bold"
                               HorizontalTextAlignment="Center" TextColor="#C62828" />
                        <Label Text="Alto" FontSize="11" FontAttributes="Bold"
                               HorizontalTextAlignment="Center" TextColor="#C62828" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                        BackgroundColor="#FFF3E0" Padding="10,12">
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="{Binding CantModerado}" FontSize="22" FontAttributes="Bold"
                               HorizontalTextAlignment="Center" TextColor="#EF6C00" />
                        <Label Text="Moderado" FontSize="11" FontAttributes="Bold"
                               HorizontalTextAlignment="Center" TextColor="#EF6C00" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                        BackgroundColor="#E8F5E9" Padding="10,12">
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="{Binding CantAlDia}" FontSize="22" FontAttributes="Bold"
                               HorizontalTextAlignment="Center" TextColor="#2E7D32" />
                        <Label Text="Al día" FontSize="11" FontAttributes="Bold"
                               HorizontalTextAlignment="Center" TextColor="#2E7D32" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="3" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                        BackgroundColor="#ECEFF1" Padding="10,12">
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="{Binding CantSinDatos}" FontSize="22" FontAttributes="Bold"
                               HorizontalTextAlignment="Center" TextColor="#546E7A" />
                        <Label Text="Sin datos" FontSize="11" FontAttributes="Bold"
                               HorizontalTextAlignment="Center" TextColor="#546E7A" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Label Text="Usá Ver para abrir la ficha del alumno."
                   FontSize="12"
                   TextColor="{AppThemeBinding Light=#78909C, Dark=#90A4AE}" />

            <!-- Misma grilla en cabecera y filas: 6px | alumno | inasist. | entregas | racha | nivel | ver -->
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                    Padding="0">
                <VerticalStackLayout Spacing="0">

                    <Grid ColumnDefinitions="6, 2.4*, 1.6*, 1.5*, 108, 128, 68"
                          ColumnSpacing="12"
                          Padding="12,12,12,12"
                          BackgroundColor="{AppThemeBinding Light=#E8EAF6, Dark=#1A237E}">
                        <Label Grid.Column="1" Text="Alumno" FontSize="12" FontAttributes="Bold"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#3949AB, Dark=#C5CAE9}" />
                        <Label Grid.Column="2" Text="Inasistencias" FontSize="12" FontAttributes="Bold"
                               HorizontalTextAlignment="Center" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#3949AB, Dark=#C5CAE9}" />
                        <Label Grid.Column="3" Text="Entregas" FontSize="12" FontAttributes="Bold"
                               HorizontalTextAlignment="Center" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#3949AB, Dark=#C5CAE9}" />
                        <Label Grid.Column="4" Text="Racha" FontSize="12" FontAttributes="Bold"
                               HorizontalTextAlignment="Center" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#3949AB, Dark=#C5CAE9}" />
                        <Label Grid.Column="5" Text="Nivel" FontSize="12" FontAttributes="Bold"
                               HorizontalTextAlignment="Center" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#3949AB, Dark=#C5CAE9}" />
                        <Label Grid.Column="6" Text="" FontSize="12" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#E0E0E0" />

                    <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Alumnos}">
                        <BindableLayout.EmptyView>
                            <Label Text="No hay alumnos para mostrar en esta comisión."
                                   HorizontalTextAlignment="Center"
                                   Margin="20"
                                   TextColor="{AppThemeBinding Light=#90A4AE, Dark=#78909C}" />
                        </BindableLayout.EmptyView>

                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="6, 2.4*, 1.6*, 1.5*, 108, 128, 68"
                                      ColumnSpacing="12"
                                      Padding="12,14"
                                      MinimumHeightRequest="66">

                                    <BoxView Grid.Column="0" Color="{Binding ColorNivel}" />

                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding NombreCompleto}"
                                               FontAttributes="Bold"
                                               FontSize="14"
                                               LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light=#212121, Dark=#FFFFFF}" />
                                        <Label Text="{Binding ContactoTexto}"
                                               FontSize="11"
                                               LineBreakMode="TailTruncation"
                                               TextColor="{Binding ContactoColor}" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2"
                                           Text="{Binding AsistenciaTexto}"
                                           FontSize="12"
                                           HorizontalTextAlignment="Center"
                                           VerticalOptions="Center"
                                           LineBreakMode="WordWrap"
                                           TextColor="{AppThemeBinding Light=#455A64, Dark=#B0BEC5}" />

                                    <Label Grid.Column="3"
                                           Text="{Binding EntregasTexto}"
                                           FontSize="12"
                                           HorizontalTextAlignment="Center"
                                           VerticalOptions="Center"
                                           LineBreakMode="WordWrap"
                                           TextColor="{AppThemeBinding Light=#455A64, Dark=#B0BEC5}" />

                                    <Border Grid.Column="4"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8"
                                            BackgroundColor="{Binding ColorFondoRacha}"
                                            WidthRequest="100"
                                            HeightRequest="30"
                                            VerticalOptions="Center"
                                            HorizontalOptions="Center">
                                        <Label Text="{Binding RachaTexto}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Fill"
                                               TextColor="{Binding ColorRacha}" />
                                    </Border>

                                    <Border Grid.Column="5"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8"
                                            BackgroundColor="{Binding ColorFondoNivel}"
                                            HeightRequest="30"
                                            WidthRequest="120"
                                            VerticalOptions="Center"
                                            HorizontalOptions="Center"
                                            Padding="4,0">
                                        <Label Text="{Binding Nivel}"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Fill"
                                               TextColor="{Binding ColorNivel}" />
                                    </Border>

                                    <Button Grid.Column="6"
                                            Text="Ver"
                                            Command="{Binding AbrirFichaCommand}"
                                            BackgroundColor="#512BD4"
                                            TextColor="White"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            CornerRadius="8"
                                            HeightRequest="32"
                                            WidthRequest="60"
                                            Padding="0"
                                            VerticalOptions="Center"
                                            HorizontalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
